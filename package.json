{
  "name": "socius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "catalog:check": "tsx scripts/check-catalog.ts",
    "build": "tsx scripts/build.ts",
    "dev": "npm run build && electron .",
    "desktop": "npm run build && electron .",
    "web": "npm run build && tsx apps/runtime/main.ts",
    "package": "npm run build && electron-builder --dir",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages scripts/*.ts e2e playwright.config.ts",
    "format:check": "prettier --check apps packages scripts/*.ts e2e playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.66",
    "@ai-sdk/amazon-bedrock": "5.0.115",
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/azure": "4.0.101",
    "@ai-sdk/baseten": "2.1.46",
    "@ai-sdk/cerebras": "3.0.68",
    "@ai-sdk/cohere": "4.0.60",
    "@ai-sdk/deepinfra": "3.0.68",
    "@ai-sdk/deepseek": "3.0.64",
    "@ai-sdk/fireworks": "3.0.71",
    "@ai-sdk/gateway": "4.0.113",
    "@ai-sdk/google": "4.0.95",
    "@ai-sdk/google-vertex": "5.0.111",
    "@ai-sdk/groq": "4.0.60",
    "@ai-sdk/huggingface": "2.0.68",
    "@ai-sdk/minimax": "3.0.56",
    "@ai-sdk/mistral": "4.0.63",
    "@ai-sdk/moonshotai": "3.0.68",
    "@ai-sdk/openai": "^4.0.93",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@ai-sdk/perplexity": "5.0.11",
    "@ai-sdk/togetherai": "3.0.69",
    "@ai-sdk/xai": "5.0.21",
    "@ai-sdk/zai": "3.0.30",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "^7.0.140",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "main": "dist/main.cjs",
  "build": {
    "appId": "in.socius.desktop",
    "productName": "Socius",
    "directories": {
      "output": "release",
      "app": "dist"
    },
    "files": [
      "**/*"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
