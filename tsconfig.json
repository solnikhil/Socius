{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./apps/web/src/*"]
    },
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "noUnusedLocals": true
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
